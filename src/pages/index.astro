---
import { join } from 'node:path';
import sharp from 'sharp';
import { loadAvatarRegistry } from '../avatarRegistry';
import LogoRegistry, { type Logo } from '../components/LogoRegistry';

const logoModules = import.meta.glob<string>('../../avatars/*.webp', {
  eager: true,
  import: 'default',
  query: '?url',
});

const collator = new Intl.Collator('zh-Hans-CN', {
  numeric: true,
  sensitivity: 'base',
});

const avatarRegistry = loadAvatarRegistry();
const registeredFilenames = new Set(avatarRegistry.map(entry => entry.filename));
const logoFiles = await Promise.all(Object.entries(logoModules).map(async ([modulePath, src]) => {
  const file = modulePath.split('/').pop() ?? '';
  const filename = file.replace(/\.webp$/i, '');
  const metadata = await sharp(join(process.cwd(), 'avatars', file)).metadata();
  return {
    file,
    filename,
    src,
    width: metadata.width ?? null,
    height: metadata.height ?? null,
  };
}));
const unregisteredLogos = logoFiles.filter(({ filename }) => !registeredFilenames.has(filename));
if (unregisteredLogos.length) {
  throw new Error(
    `Avatar registry error: ${unregisteredLogos.length} WebP files have no registry entry:\n${unregisteredLogos
      .map(({ file }) => `- ${file}`)
      .join('\n')}`,
  );
}
const logoByFilename = new Map(logoFiles.map(logo => [logo.filename, logo]));
const logos: Logo[] = avatarRegistry.flatMap((entry) => {
  const logo = logoByFilename.get(entry.filename);
  if (!logo) return [];
  return [{
    id: entry.id,
    icpcId: /^\d+$/.test(entry.id) ? entry.id : null,
    name: entry.name,
    src: logo.src,
    file: logo.file,
    width: logo.width,
    height: logo.height,
  }];
}).sort((left, right) => collator.compare(left.name, right.name));

const missingLogos = avatarRegistry.filter(({ filename }) => !logoByFilename.has(filename));
if (missingLogos.length) {
  console.warn(
    `Avatar registry warning: ${missingLogos.length} entries have no WebP and will not be shown:\n${missingLogos
      .map(({ id, name }) => `- ${id}: ${name}`)
      .join('\n')}`,
  );
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Hydro Contest Team School Logo Registry"
    />
    <link rel="icon" type="image/png" href="/HydroLogo.png" />
    <title>Hydro Contest Team School Logo Registry</title>
  </head>
  <body>
    <LogoRegistry client:load logos={logos} />
  </body>
</html>
