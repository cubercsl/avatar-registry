---
import { join } from 'node:path';
import sharp from 'sharp';
import { loadAvatarRegistry } from '../avatarRegistry';
import LogoRegistry, { type Logo } from '../components/LogoRegistry';

const logoModules = import.meta.glob<string>('../../avatars/*.webp', {
  eager: true,
  import: 'default',
  query: '?url',
});

const collator = new Intl.Collator('zh-Hans-CN', {
  numeric: true,
  sensitivity: 'base',
});

const avatarRegistry = await loadAvatarRegistry();
const registryByName = new Map(avatarRegistry.map(entry => [entry.name, entry]));
const logoFiles = Object.entries(logoModules).map(([modulePath, src]) => {
  const file = modulePath.split('/').pop() ?? '';
  const name = file.replace(/\.webp$/i, '');
  return { file, name, registryEntry: registryByName.get(name), src };
});
const unregisteredLogos = logoFiles.filter(({ registryEntry }) => !registryEntry);
if (unregisteredLogos.length) {
  console.warn(
    `Avatar files warning: ${unregisteredLogos.length} WebP files have no registry entry and will be shown without ID metadata:\n${unregisteredLogos
      .map(({ file }) => `- ${file}`)
      .join('\n')}`,
  );
}
const logos: Logo[] = (
  await Promise.all(
    logoFiles.map(async ({ file, name, registryEntry, src }) => {
      const metadata = await sharp(join(process.cwd(), 'avatars', file)).metadata();
      return {
        id: registryEntry?.id ?? null,
        icpcId: registryEntry && /^\d+$/.test(registryEntry.id) ? registryEntry.id : null,
        name,
        src,
        file,
        width: metadata.width ?? null,
        height: metadata.height ?? null,
      };
    }),
  )
).sort((left, right) => collator.compare(left.name, right.name));

const logoIds = new Set(logos.flatMap(({ id }) => id ? [id] : []));
const missingLogos = avatarRegistry.filter(({ id }) => !logoIds.has(id));
if (missingLogos.length) {
  console.warn(
    `Avatar registry warning: ${missingLogos.length} entries have no WebP and will not be shown:\n${missingLogos
      .map(({ id, name }) => `- ${id}: ${name}`)
      .join('\n')}`,
  );
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Hydro Contest Team School Logo Registry"
    />
    <link rel="icon" type="image/png" href="/HydroLogo.png" />
    <title>Hydro Contest Team School Logo Registry</title>
  </head>
  <body>
    <LogoRegistry client:load logos={logos} />
  </body>
</html>
